# Copy to .env and fill in. Never commit .env.
# Comments go on their own lines: `docker run --env-file` keeps anything after `=` as the value.

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Aliases always point at Google's current Flash models. Pin dated models in production.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Client-side cap so a multi-step answer stays inside the free tier's per-minute quota.
LLM_REQUESTS_PER_MINUTE=10

# BigQuery: project billed for queries (the dataset itself is public).
# Authenticate once with: gcloud auth application-default login
# (or, where no browser login is possible, use a service-account key with the BigQuery Job
#  User role in this project: either point to the file, or put the key itself ON ONE LINE in
#  GCP_SA_KEY_JSON (jq -c . key.json), which is held in memory only and wins over the others)
GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# GCP_SA_KEY_JSON=
# bigquery, or duckdb for the offline synthetic sample (see README)
WAREHOUSE=bigquery
# Hard per-query ceiling enforced by BigQuery (1 GB)
MAX_BYTES_BILLED=1000000000
QUERY_TIMEOUT_S=60

# Per-question budgets (cost and loop control)
MAX_LLM_REQUESTS_PER_TURN=16
MAX_QUERIES_PER_TURN=10
# Consecutive failed or empty queries before the agent must stop and explain
MAX_SQL_ATTEMPTS=3
MAX_ROWS_TO_LLM=50
TURN_TIMEOUT_S=240
HISTORY_TURNS=8

# HTTP API (python -m retail_agent serve): bearer tokens per demo user, at least 16 characters each.
# Without them the API refuses every request. Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# API_TOKENS=ceo:<token>,maria:<token>,tom:<token>

# Optional
# PERSONA_FILE=config/persona.md
# DATA_DIR=.data
# LOG_LEVEL=WARNING
