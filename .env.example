# Copy to .env and fill in. Never commit .env.

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Aliases always point at Google's current Flash models. Pin dated models in production.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Client-side cap so a multi-step answer stays inside the free tier's per-minute quota.
LLM_REQUESTS_PER_MINUTE=10

# BigQuery: project billed for queries (the dataset itself is public).
# Authenticate once with: gcloud auth application-default login
# (or, where no browser login is possible, put a service-account key with the
#  BigQuery Job User role in GCP_SA_KEY_JSON; it is written to .data/ at startup)
GOOGLE_CLOUD_PROJECT=
# GCP_SA_KEY_JSON=
WAREHOUSE=bigquery            # or duckdb (offline synthetic sample, see README)
MAX_BYTES_BILLED=1000000000   # hard per-query ceiling enforced by BigQuery (1 GB)
QUERY_TIMEOUT_S=60

# Per-question budgets (cost and loop control)
MAX_LLM_REQUESTS_PER_TURN=16
MAX_QUERIES_PER_TURN=10
MAX_SQL_ATTEMPTS=3            # consecutive failed/empty queries before the agent must stop and explain
MAX_ROWS_TO_LLM=50
TURN_TIMEOUT_S=240
HISTORY_TURNS=8

# Optional
# PERSONA_FILE=config/persona.md
# DATA_DIR=.data
# LOG_LEVEL=WARNING
